{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-edition",
  // worker/index.ts re-exports OpenNext's .open-next/worker.js plus the Durable Objects, Workflows and cron handler.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // No public *.workers.dev address (docs/CLOUDFLARE.md, approval 1): the Pages project "localedition" fronts this Worker
  // through a service binding (edge/pages/), and https://localedition.pages.dev is the judge URL.
  "workers_dev": false,

  "vars": {
    // Production default. `next dev` ignores this file's vars and keeps STORE_DRIVER=file unless set in .env.local.
    "STORE_DRIVER": "d1",
    "BUILD_MODE": "workflow",
    // Provider modes. Unset, env.ts defaults every one of these to `replay` (recorded sample data), so a deployment
    // without them would never call a model or Tavily. TF_MODE and TAVILY_MODE are live in production.
    // QLOO_MODE stays `replay` (recorded Qloo answers) until Qloo's key exists: it becomes `live` when QLOO_API_KEY is set
    // (change this value in the same deploy that runs `wrangler secret put QLOO_API_KEY`).
    "TF_MODE": "live",
    "TAVILY_MODE": "live",
    "QLOO_MODE": "replay",
    // Secrets, set with `wrangler secret put`: LE_JOB_SECRET (the Worker only verifies the Nebius job's signatures with it), NEBIUS_API_KEY
    // (Token Factory), QLOO_API_KEY, TAVILY_API_KEY. Never .dev.vars. NEBIUS_SA_CREDENTIALS is NEVER a Worker secret: no Worker, cron or
    // Workflow calls the Nebius AI Cloud control plane (it answers Cloudflare egress with a 522, docs/NEBIUS-REST.md). NeMo
    // certify/eval/import jobs are started on demand from a developer's CLI session (scripts/nebius-job.ts) and post back to APP_URL.
    "APP_URL": "https://localedition.pages.dev"
  },

  // Monday 00:00 UTC (08:00 Kuala Lumpur): the weekly rebuild Workflow (Token Factory and Tavily only). Cloudflare numbers weekdays from Sunday, so name the day.
  "triggers": { "crons": ["0 0 * * MON"] },

  "d1_databases": [
    // Create with `wrangler d1 create local-edition`, paste the id here, then `wrangler d1 migrations apply LE_DB --remote`.
    { "binding": "LE_DB", "database_name": "local-edition", "database_id": "236b5ca1-cb3b-4c85-8d4b-38e5e29e748f", "migrations_dir": "migrations" }
  ],
  // Provider cache (Qloo, Tavily) with TTL. Create with `wrangler kv namespace create LE_KV`.
  "kv_namespaces": [{ "binding": "LE_KV", "id": "725a5fb484954db4a5d12dc99ff0fb9a" }],
  // Menu photos: ws/<workspaceId>/<uuid>.<ext>. Create with `wrangler r2 bucket create local-edition-blobs`.
  "r2_buckets": [{ "binding": "LE_BLOB", "bucket_name": "local-edition-blobs" }],

  "durable_objects": {
    "bindings": [
      { "name": "SPEND_METER", "class_name": "SpendMeterDO" },
      { "name": "BUILD_LOCK", "class_name": "BuildLockDO" },
      // The global Tavily credit ledger (80 credits through 15 Dec, 6 a day), counted across every workspace.
      { "name": "TAVILY_BUDGET", "class_name": "TavilyBudgetDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SpendMeterDO", "BuildLockDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TavilyBudgetDO"] }
  ],

  "workflows": [
    { "name": "local-edition-edition-build", "binding": "EDITION_BUILD", "class_name": "EditionBuild" },
    { "name": "local-edition-weekly-rebuild", "binding": "WEEKLY_REBUILD", "class_name": "WeeklyRebuild" }
  ],

  "observability": { "enabled": true }
}
